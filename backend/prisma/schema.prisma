generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime   @default(now())
  invitations   Invitation[]
  printOrders   PrintOrder[]
}

model PrintOrder {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  templateId String
  data String
  status String @default("draft")
  paymentId String @default("")
  paymentKey String @default(uuid())
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Invitation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  slug          String   @unique
  templateId    String
  status        String   @default("draft") // draft | paid | published
  title         String   @default("")

  // Couple info
  groomName     String   @default("")
  brideName     String   @default("")
  weddingDate   String   @default("")
  weddingTime   String   @default("")
  venue         String   @default("")
  venueAddress  String   @default("")
  mapLink       String   @default("")
  story         String   @default("")
  inviteText    String   @default("")
  dressCode     String   @default("")
  dressCodeColors String @default("[]") // JSON: ["#hex",...]
  dressCodePhoto  String @default("")
  schedule      String   @default("[]") // JSON: [{time,title,icon}]

  // Media
  coverPhoto    String   @default("")  // path to uploaded file
  coverVideo    String   @default("")  // path to uploaded video
  galleryPhotos String   @default("[]") // JSON array of paths

  // Appearance
  colorScheme   String   @default("classic")
  musicUrl      String   @default("")
  enabledSections String @default("{\"couple\":true,\"event\":true,\"schedule\":true,\"style\":true,\"gallery\":true}")

  // Template-specific editable fields (JSON object keyed by field id)
  customData    String   @default("{}")

  // Payment
  paymentId     String   @default("")
  paidAt        DateTime?
  plan          String   @default("basic") // basic | standard | premium

  // Custom domain (MVP — хранится домен + показывается DNS-инструкция)
  customDomain  String   @default("")

  // Notifications (пара выбирает один канал: telegram | email | none)
  notifyChannel         String @default("none")
  notifyEmail           String @default("")
  notifyTelegramChatId  String @default("")
  telegramConnectToken  String @default("")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  guestResponses GuestResponse[]
  guests        Guest[]

  // Планировщик (рассадка и меню) — см. модели ниже; колонок в Invitation они не добавляют
  plannerSettings PlannerSettings?
  menuOptions   MenuOption[]
  seatTables    SeatTable[]
  persons       Person[]
  plannerNotices PlannerNotice[]
}

// Гости продвинутого тарифа (ручной список с персональными ссылками)
model Guest {
  id            String   @id @default(uuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  token         String   @unique               // короткий токен для персональной ссылки ?g=
  salutation    String   @default("дорогие")   // дорогой | дорогая | дорогие | семья
  names         String                          // «Денис и Мария» / «Кореловых»
  responseId    String?                         // связь с ответом (GuestResponse)
  createdAt     DateTime @default(now())
  persons       Person[]

  @@index([invitationId])
}

model GuestResponse {
  id            String   @id @default(uuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id])
  guestId       String?                    // связь с гостем (продвинутый тариф)
  guestName     String
  attending     Boolean
  drinkChoice   String   @default("")   // wine | champagne | juice | water | no_alcohol | other
  wishes        String   @default("")
  // Сколько человек придёт по этому ответу (гость и те, кто с ним). В рабочую
  // базу колонку дописывает сам бэкенд при запуске — src/lib/ensureSchema.ts.
  guestsCount   Int      @default(1)
  // Ответ «придёт»: yes | no | maybe. Пустой у ответов, записанных до вопроса
  // «Пока не знаю», — для них статус берётся из attending (lib/rsvpDetails.ts).
  attendance    String   @default("")
  // Сколько из guestsCount — дети (анкета спрашивает отдельно, если пара включила)
  childrenCount Int      @default(0)
  // Ответы на дополнительные вопросы анкеты, JSON: [{ id, q, a, t }]
  answers       String   @default("[]")
  createdAt     DateTime @default(now())
  persons       Person[]

  @@index([guestId])
}

// ── Планировщик: меню и рассадка ─────────────────────────────────────────────
// Только новые таблицы: существующие не меняются. В рабочую базу их создаёт сам
// бэкенд при запуске (src/lib/ensureSchema.ts) — деплой миграции не запускает.

// Настройки приглашения: что спрашивать у гостей в анкете и что показывать на сайте.
// Всё выключено, пока пара не включит сама.
model PlannerSettings {
  invitationId String     @id
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  askMenu      Boolean    @default(false) // спрашивать выбор блюда у каждого гостя
  askDiet      Boolean    @default(false) // спрашивать пищевые ограничения (необязательно)
  showMenu     Boolean    @default(false) // показывать меню на сайте (этап 5)
  showTable    Boolean    @default(false) // показывать гостю его стол (этап 5)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Вариант выбора блюда в анкете: «Мясное», «Рыбное», «Детское»…
model MenuOption {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  label        String
  note         String     @default("")
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  persons      Person[]

  @@index([invitationId])
}

model SeatTable {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int
  shape        String     @default("round") // round | long — только вид схемы и печати
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  persons      Person[]

  @@unique([invitationId, name])
}

// Один человек = одна строка со своим идентификатором. Принадлежит ровно одной группе:
// Guest (персональная ссылка) или GuestResponse (ответ по общей ссылке сайта).
model Person {
  id           String         @id @default(uuid())
  invitationId String
  invitation   Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestId      String?
  guest        Guest?         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  responseId   String?
  response     GuestResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  slot         Int            @default(0)     // порядковый номер внутри группы
  name         String         @default("")    // пусто = состав группы нужно уточнить
  isChild      Boolean        @default(false)
  excluded     Boolean        @default(false) // «убран из списка»: строка остаётся учтённой
  menuOptionId String?
  menuOption   MenuOption?    @relation(fields: [menuOptionId], references: [id], onDelete: SetNull)
  menuReview   Boolean        @default(false) // вариант меню удалён — выбор нужно уточнить
  diet         String         @default("")    // пищевые ограничения, необязательно
  tag          String         @default("")    // метка группы: «Семья жениха», «Друзья»
  tableId      String?
  table        SeatTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([guestId, slot])
  @@unique([responseId, slot])
  @@index([invitationId])
  @@index([tableId])
  @@index([menuOptionId])
}

// Сообщения владельцу в кабинете: «Анна отказалась — снята со стола 5».
model PlannerNotice {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  kind         String
  text         String
  seenAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([invitationId, seenAt])
}
